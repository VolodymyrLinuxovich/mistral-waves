# Copy to .env and fill in. NEVER commit .env.
# CDS credentials are read from ~/.cdsapirc by the cdsapi client; these vars are
# an alternative for containerised runs.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_TOKEN=

# MapTiler key for the MapLibre basemap (frontend, public — build-time inlined).
NEXT_PUBLIC_MAPTILER_API_KEY=

# Forecast provider selector.
FORECAST_PROVIDER=open_meteo
