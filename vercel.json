{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{backend/**,config/**,data/processed/ukraine_heat_thresholds_provisional.npz,data/processed/ukraine_heat_thresholds_provisional.meta.json,data/processed/baseline_metadata.json,data/processed/historical_events.json,data/processed/historical_footprints/**,data/demo/**,data/boundaries/kyiv_districts.geojson,data/boundaries/kyiv_districts.provenance.json}"
    }
  }
}
